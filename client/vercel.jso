{
  "version": 2,
  "builds": [{ "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } }],
  "routes": [
    { "src": "/api/(.*)", "headers": { "Access-Control-Allow-Origin": "*" }, "dest": "https://shop-order-manager-upw3.vercel.app/api$1" },
    { "src": "/(.*)", "dest": "/dist/index.html" }
  ]
}