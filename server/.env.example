PORT=5000

# PostgreSQL connection string
# Local:    postgresql://postgres:postgres@localhost:5432/shop_order_manager
# Supabase: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shop_order_manager

# Force SSL on/off. Leave unset to auto-detect from ?sslmode=require.
# PGSSL=false

# Create missing tables/indexes automatically on startup.
PG_AUTO_MIGRATE=true

JWT_SECRET=replace_this_with_a_long_random_secret
NODE_ENV=development
